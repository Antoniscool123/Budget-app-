{
  "name": "budget-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Budget-app med kvitteringsscanning (OCR) og månedligt budget",
  "scripts": {
    "dev": "node scripts/setup-ocr.mjs && vite --host 0.0.0.0",
    "build": "node scripts/setup-ocr.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/setup-ocr.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tesseract.js-data/dan": "^1.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^31.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
